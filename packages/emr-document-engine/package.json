{
  "name": "@emrde/document-engine",
  "version": "21.0.0",
  "private": true,
  "description": "EMR 电子病历文档引擎 —— 框架与平台无关的文档编辑内核 (可嵌入 React / Vue / Electron / Web Worker)",
  "license": "MPL-2.0",
  "author": "陈庄旺 <1665527118@qq.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/engine/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/engine/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dom": {
      "types": "./dist/types/platform/dom/index.d.ts",
      "import": "./dist/dom.js",
      "require": "./dist/dom.cjs"
    },
    "./react": {
      "types": "./dist/types/platform/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./export": {
      "types": "./dist/types/lib/export/index.d.ts",
      "import": "./dist/export.js",
      "require": "./dist/export.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "keywords": [
    "emr",
    "document",
    "editor",
    "canvas",
    "framework-agnostic",
    "电子病历"
  ]
}
